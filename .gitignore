# dependencies
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
.next/
out/

# environment — never commit real secrets
.env
.env.local
.env.*.local
.claude/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editors / OS
.DS_Store
.idea/
*.swp

# test / cache
coverage/
.eslintcache

# typescript incremental build cache
*.tsbuildinfo
# Vercel CLI local state and build output
.vercel

# Secrets. The documented example files stay tracked.
.env*
!.env.example
!**/.env.example

# Regenerated by Next on every dev and build run, and its contents flip between
# the two. Committing it means every developer fights the same phantom diff.
next-env.d.ts
