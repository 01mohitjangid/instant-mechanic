# ---------------------------------------------------------------------------
# Instant Mechanic — backend environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon serverless Postgres).
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Port the Express API listens on (used from Step 2 onward).
PORT=4000

# development | test | production
NODE_ENV=development

# Timezone the operations team works in. "Today's bookings" is resolved in
# this zone, not in the server's timezone.
APP_TIMEZONE=Asia/Kolkata

# Browser origins allowed to call this API. "*" for local development;
# set the real Vercel URL in production.
CORS_ORIGINS=*

# Requests allowed per IP per window.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MINUTES=1

# Number of reverse proxies in front of this API, or "false" for none.
# Set to 1 behind an AWS load balancer. Leaving it on without a real proxy lets
# anyone bypass the rate limiter with a forged X-Forwarded-For header.
TRUST_PROXY=false
