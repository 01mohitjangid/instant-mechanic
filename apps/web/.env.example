# ---------------------------------------------------------------------------
# Instant Mechanic — dashboard environment variables
# ---------------------------------------------------------------------------

# Base URL of the operations API. Falls back to http://localhost:4000 when unset,
# so a fresh clone runs locally with no .env file at all.
# In production this is the deployed AWS URL, e.g. https://api.instantmechanic.example
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Port for the dashboard itself. Defaults to 3000; set it if another project
# already owns that port. Deliberately not PORT — that one belongs to the API,
# and `npm run dev` runs both in one shell.
WEB_PORT=3000
