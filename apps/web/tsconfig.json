{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next bundles the app, so it needs bundler resolution rather than the
    // NodeNext the base config sets for the server-side workspaces.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    // Relaxed for React: a component that spreads optional props trips this
    // rule constantly without catching a real bug.
    "exactOptionalPropertyTypes": false,
    "paths": { "@/*": ["./src/*"] },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
