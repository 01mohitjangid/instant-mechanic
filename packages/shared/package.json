{
  "name": "@instant-mechanic/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Types shared by the API and the dashboard, so the two cannot drift apart",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
